// Cryptol specification for next-step #5 (artifact signing / attestation support).
// Simple SHA-256-like reduction and a toy MAC for evidence manifests.
// Intended as a high-assurance reference for offline integrity checks.

module EvidenceHash where

type Word = [32]
type Digest = [8][32]  // 256-bit

// Toy compression function (not real SHA-256; placeholder for verified primitive)
compress : [16]Word -> Digest -> Digest
compress block state = 
  [ state @ 0 ^ (block @ 0 + state @ 1)
  , state @ 1 ^ (block @ 1 + state @ 2)
  , state @ 2 ^ (block @ 2 + state @ 3)
  , state @ 3 ^ (block @ 3 + state @ 4)
  , state @ 4 ^ (block @ 4 + state @ 5)
  , state @ 5 ^ (block @ 5 + state @ 6)
  , state @ 6 ^ (block @ 6 + state @ 7)
  , state @ 7 ^ (block @ 7 + state @ 0)
  ]

// Pad and hash a sequence of words (simplified)
hashWords : [inf]Word -> Digest
hashWords ws = hashAcc ws (zero : Digest)
  where
    hashAcc [] s = s
    hashAcc (b:bs) s = hashAcc bs (compress (take`{16} (b : zero)) s)  // pad to 16

// Simple keyed MAC for attestation (HMAC-like skeleton)
mac : [8]Word -> [inf]Word -> Digest
mac key msg = hashWords (key # msg)

// Property: MAC is deterministic
property macDeterministic (k : [8]Word) (m : [16]Word) =
  mac k m == mac k m

// Property: different keys give different MACs (probabilistic, for small domain)
property macKeyDiff (k1 k2 : [8]Word) (m : [8]Word) =
  k1 != k2 ==> mac k1 m != mac k2 m
