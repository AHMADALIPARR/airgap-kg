// SAW script for next-step #5 formal verification of the Cryptol hash/MAC.
// Loads the Cryptol module and proves the determinism property.
// Run with: saw verify_evidence_hash.saw
// (requires SAW and Cryptol in PATH)

import "Cryptol";

let cry_file = "formal/cryptol/EvidenceHash.cry";

// Load the Cryptol module
let m = cryptol_load cry_file;

// Extract the macDeterministic theorem and prove it
let thm = cryptol_extract m "macDeterministic";

// Prove with the default solver (Z3 or whatever is configured)
prove_print thm;

// Optional: also extract and check macKeyDiff on a bounded domain
// let thm2 = cryptol_extract m "macKeyDiff";
// prove_print thm2;

print "SAW verification of EvidenceHash.cry completed.";
